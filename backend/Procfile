redis: redis-server --port 6379 --bind 127.0.0.1 --save "" --appendonly no --maxmemory 32mb --maxmemory-policy noeviction
worker: sleep 30 && exec celery -A returnpilot.jobs worker --pool=solo --concurrency=1 --loglevel=warning --without-gossip --without-mingle --without-heartbeat -B --schedule /tmp/celerybeat-schedule
web: uvicorn returnpilot.api.main:app --host 0.0.0.0 --port ${WEB_PORT:-10000} --proxy-headers --forwarded-allow-ips=* --timeout-keep-alive 75
