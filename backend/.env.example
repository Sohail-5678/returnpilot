# Local development. Production values live in Render (see render.yaml) — never commit real keys.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/returnpilot
REDIS_URL=redis://127.0.0.1:6379/0
# Public half of the web app's ES256 signing key (base64 PEM). `pnpm setup:env` in apps/web prints it.
JWT_PUBLIC_KEY=
ALLOWED_ORIGINS=http://localhost:3000
# FAKE_LLM=true uses the scripted model (no API keys needed). Set it to false and add keys for real models.
FAKE_LLM=true
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL_MAIN=llama-3.3-70b-versatile
GROQ_MODEL_SMALL=llama-3.1-8b-instant
GEMINI_MODEL_FALLBACK=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
MCP_URL=http://127.0.0.1:8765/mcp
MCP_INTERNAL_TOKEN=dev-mcp-token
CRON_TOKEN=dev-cron-token
REFUND_AUTO_APPROVE_LIMIT=50
DEMO_MODE=true
