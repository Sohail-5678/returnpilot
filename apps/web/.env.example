# ReturnPilot web (Next.js) — environment variables
# Copy to .env.local for local dev, or run `pnpm setup:env` to generate one with throwaway keys.

# Base URL of the FastAPI backend (no trailing slash). The web server proxies /api/v1/* to ${BACKEND_URL}/v1/*.
BACKEND_URL=http://localhost:10000

# ES256 private key used to sign the 5-minute JWT sent to the backend (API_CONTRACT §1).
# Value = base64 of the PKCS#8 PEM ("-----BEGIN PRIVATE KEY-----..."). The backend holds the matching public key.
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | base64 | tr -d '\n'
JWT_PRIVATE_KEY=

# Auth.js session encryption secret (32+ random bytes). Generate: openssl rand -base64 32
AUTH_SECRET=

# Optional GitHub OAuth app. "Continue with GitHub" only appears when both are set.
# Callback URL: https://<your-app>.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated GitHub logins that get elevated roles. Everyone else signs in as a customer.
ADMIN_GITHUB_USERS=
REVIEWER_GITHUB_USERS=

# "true" enables the demo persona sign-in (Maya, Arjun, Lena, Riley the reviewer, Avery the admin).
DEMO_MODE=true

# "true" serves realistic fixtures from lib/mock instead of calling the backend (UI development only).
MOCK_BACKEND=false

# Public link to the source code, shown on the landing page and footer.
NEXT_PUBLIC_GITHUB_URL=https://github.com/Sohail-5678/returnpilot

# --- Mock-mode-only development knobs (ignored when MOCK_BACKEND is not "true") ---
# Simulate a cold Render start: API calls return 503 backend_starting for the first N seconds.
# MOCK_COLD_START_SECONDS=20
# Pace of the scripted SSE stream: 1 = demo speed, 0 = instant (used by tests).
# MOCK_SPEED=1
